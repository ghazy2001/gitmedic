# GitMedic 🩺 Environment Configuration

# GitHub App Credentials (from GitHub Settings > Developer Settings > GitHub Apps)
APP_ID=
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
WEBHOOK_SECRET=development_secret

# For local development with Smee.io (live webhook proxy)
# Go to https://smee.io/new and paste your proxy URL here:
WEBHOOK_PROXY_URL=

# Port & Node Environment
PORT=3000
NODE_ENV=development

# AI LLM Provider Keys
# GitMedic supports Gemini, Claude (Anthropic), and OpenAI
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default LLM Provider: 'gemini' | 'anthropic' | 'openai'
DEFAULT_AI_PROVIDER=gemini

# Bot Trigger Command in GitHub Issue Comments
BOT_TRIGGER_COMMAND=@gitmedic
AUTO_CURE_LABELS=gitmedic,bug,triage-needed
